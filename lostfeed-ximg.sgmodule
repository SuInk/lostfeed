#!name=LostFeed · X 图片墙（测试）
#!desc=记录 X App 里刷到的图片和视频封面（只有图片，点不回原帖）。需要和 LostFeed 一起开。如果 X 的图片加载不出来，关掉这个模块即可
#!author=diana
#!homepage=https://github.com/SuInk/lostfeed

[Script]
lostfeed-ximg = type=http-request,pattern=^https:\/\/pbs\.twimg\.com\/(media|amplify_video_thumb|ext_tw_video_thumb|tweet_video_thumb)\/,timeout=5,argument=max=1500,script-path=https://raw.githubusercontent.com/SuInk/lostfeed/main/lostfeed.js?v=7

[MITM]
hostname = %APPEND% pbs.twimg.com
